# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AI Model configuration
AI_MODEL="gemini-3.8-flash"

# Port & App URL
PORT=3000
APP_URL="http://localhost:3000"

# Application Security
SESSION_SECRET="bilal_ai_agent_super_secret_session_key_2026"
ALLOWED_ORIGIN="http://localhost:3000"

# Database Configuration (Defaults to persistent local storage with PostgreSQL compatibility)
DATABASE_URL="file:./data/bilal_agent.json"

# WhatsApp Cloud API / Business Integration
# Get these from Meta for Developers (developers.facebook.com)
WHATSAPP_API_KEY=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_VERIFY_TOKEN="bilal_whatsapp_webhook_secret_token"

# TikTok For Developers Integration
# Get these from developers.tiktok.com
TIKTOK_CLIENT_ID=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REDIRECT_URI="http://localhost:3000/api/integrations/tiktok/callback"

# Optional Playwright / Browser Automation Settings
HEADLESS_BROWSER="true"
BROWSER_TIMEOUT_MS="30000"
